# Required in production. Generate with: openssl rand -base64 48
# This project does not provide a login flow yet; production users need JWTs
# issued by your identity provider or authentication service.
JWT_SECRET="replace-with-a-64-character-random-secret-before-production"

# Optional. Without this key, PulseBoard uses its local analytical fallback.
GEMINI_API_KEY=""
# Optional. Defaults to gemini-3.7-flash.
GEMINI_MODEL="gemini-3.7-flash"

# Optional. Defaults to 3000.
PORT=3000

# Use production only in a deployed environment. Demo personas and reset routes
# are unavailable when NODE_ENV is production.
NODE_ENV=development
